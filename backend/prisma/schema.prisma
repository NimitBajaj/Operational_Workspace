// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  LEAD
  SITE_VISIT
  QUOTATION_DRAFT
  QUOTATION_SENT
  NEGOTIATION
  ORDER_CONFIRMED
  PROCUREMENT
  VENDOR_WORK
  READY_FOR_DISPATCH
  DELIVERED
  INSTALLATION
  COMPLETED
  CANCELLED
}

enum CustomerType {
  ARCHITECT
  BUILDER
  CONTRACTOR
  OWNER
}

enum ContactRole {
  ARCHITECT
  BUILDER
  CONTRACTOR
  INSTALLATION_WORKER
  SITE_MANAGER
}

enum QuotationStatus {
  QUOTATION_DRAFT
  QUOTATION_SENT
  APPROVED
  REJECT
  REVISION
}

enum TaskStatus {
  IN_PROGRESS
  DELAYED
  COMPLETED
  BLOCKED
  RESOLVED
  PENDING
}

enum TaskType {
  SITE_VISIT
  VENDOR_FOLLOW_UP
  SAMPLE_DELIVERY
  SAMPLE_COLLECTION
  INSTALLATION
  PAYMENT_FOLLOW_UP
  DISPATCH
  PROCUREMENT
  GENERAL
}

enum DocumentType {
  IMAGE
  CAD
  PDF
  DATASHEET
  QUOTATION
  RECEIPT
  SITE_PHOTO
  INSTALLATION_PHOTO
  WARRANTY
  OTHER
}

enum ActivityType {
  PROJECT_CREATED

  SITE_VISIT

  QUOTATION_CREATED
  QUOTATION_SENT
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED

  SAMPLE_SENT
  SAMPLE_COLLECTED

  ORDER_CONFIRMED

  VENDOR_ASSIGNED
  VENDOR_WORK_COMPLETED

  DISPATCHED
  DELIVERED

  INSTALLATION_STARTED
  INSTALLATION_COMPLETED

  PAYMENT_RECEIVED

  TASK_COMPLETED

  DOCUMENT_UPLOADED

  NOTE_ADDED

  STATUS_CHANGED

  OTHER
}

enum PaymentType {
  ADVANCE
  INTERMEDIATE
  FINAL
  REFUND
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum EntityType {
  PRODUCT
  PROJECT
  QUOTATION
  PAYMENT
  TASK
  SAMPLE
}

enum Priority {
  TOP_PRIORITY
  MEDIUM_PRIORITY
  LOW_PRIORITY
}

enum NoteType {
  GENERAL
  SITE_VISIT
  CUSTOMER_DISCUSSION
  PRODUCT_REFERENCE
  MEASUREMENTS
  FOLLOW_UP
  INSTALLATION
  PAYMENT
}

enum PaymentStatus {
  ADVANCE_COMPLETE
  PENDING
  PARTIAL
  COMPLETED
  DELAYED
}

model Customer {
  // Primary Key
  id String @id @default(cuid())

  // Basic Information
  name      String
  type      CustomerType
  email     String
  phone     String
  gstNumber String?

  // Address
  address String?
  city    String?
  state   String?
  pincode String?

  // Additional Information
  notes String?

  // Relationships
  contacts Contact[]
  projects Project[]

  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([type])
}

model Task {
  id String @id @default(cuid())

  projectId String

  title       String
  description String?

  type     TaskType
  status   TaskStatus
  priority Priority

  dueDate     DateTime?
  completedAt DateTime?

  isReminderSent Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([dueDate])
}

model Project {
  id String @id @default(cuid())

  customerId String

  title       String
  description String?

  location    String?
  projectType String?

  status   ProjectStatus
  priority Priority

  estimatedValue Decimal? @db.Decimal(12, 2)

  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  quotations Quotation[]
  tasks      Task[]
  payments   Payment[]
  notes      Note[]
  documents  Document[]
  activities Activity[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projectContacts ProjectContact[]

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([expectedCompletionDate])
}

model Contact {
  id String @id @default(cuid())

  customerId String

  name String

  role ContactRole

  phone String
  email String?

  company     String?
  designation String?

  address String?
  city    String?
  state   String?

  notes String?

  isPrimary Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projectContacts ProjectContact[]

  @@index([customerId])
  @@index([role])
}

model ProjectContact {
  projectId String
  contactId String

  project Project @relation(fields: [projectId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id])

  @@id([projectId, contactId])
}

model Product {
  id String @id @default(cuid())

  name        String
  description String?

  category String
  brand    String?

  warranty String?

  active Boolean @default(true)

  variants  ProductVariant[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([brand])
  @@index([active])
}

model ProductVariant {
  // Primary Key
  id String @id @default(cuid())

  // Foreign Key
  productId String

  // Product Identification
  sku String? @unique

  // Technical Specifications
  wattage          String?
  colorTemperature String?
  finish           String?
  beamAngle        String?
  cutout           String?
  dimensions       String?
  voltage          String?
  ipRating         String?
  cri              String?

  // Commercial Information
  supplierCode String?

  costPrice    Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)

  gstPercent Decimal @db.Decimal(4, 2)

  // Inventory
  stockQuantity Int @default(0)

  active Boolean @default(true)

  // Relationships
  product Product @relation(fields: [productId], references: [id])

  quotationItems QuotationItem[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([active])
}

model Quotation {
  id String @id @default(cuid())

  projectId String

  quotationNumber String @unique
  version         Int    @default(1)

  status QuotationStatus

  subtotal Decimal  @db.Decimal(12, 2)
  discount Decimal? @db.Decimal(12, 2)
  gst      Decimal? @db.Decimal(12, 2)
  total    Decimal  @db.Decimal(12, 2)

  validUntil DateTime?

  remarks String?

  isCurrent Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id])

  items     QuotationItem[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@index([projectId, isCurrent])
  @@index([createdAt])
}

model QuotationItem {
  id String @id @default(cuid())

  quotationId      String
  productVariantId String

  displayName String

  quantity Int

  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal? @db.Decimal(12, 2)
  gst       Decimal? @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)

  remarks String?

  quotation      Quotation      @relation(fields: [quotationId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([productVariantId])
}

model Document {
  id String @id @default(cuid())

  name     String
  fileName String
  fileUrl  String
  fileSize Int?
  mimeType String?

  type        DocumentType
  description String?

  productId   String?
  projectId   String?
  quotationId String?

  product   Product?   @relation(fields: [productId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  uploadedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([projectId])
  @@index([quotationId])
  @@index([type])
}

model Note {
  id String @id @default(cuid())

  projectId String

  title   String?
  content String

  type NoteType

  tags String[]

  isPinned Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([createdAt])
}

model Activity {
  id String @id @default(cuid())

  projectId String

  type ActivityType

  title       String
  description String?

  entityType EntityType?
  entityId   String?

  performedBy String?

  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([type])
  @@index([createdAt])
}

model Payment {
  id String @id @default(cuid())

  projectId String

  type PaymentType

  amount Decimal @db.Decimal(12, 2)

  dueDate DateTime?
  paidAt  DateTime?

  paymentMethod PaymentMethod?

  referenceNumber String?

  followUpDate DateTime?
  status       PaymentStatus

  remarks String?

  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([dueDate])
  @@index([status])
  @@index([followUpDate])
  @@index([paidAt])
}
